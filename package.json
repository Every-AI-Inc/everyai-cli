{
  "name": "@everyai/cli",
  "version": "0.6.1",
  "private": false,
  "description": "The agent-agnostic command-line surface for Every AI.",
  "type": "module",
  "bin": {
    "every": "dist/index.js",
    "everyai": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs || exit 0",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.2.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
